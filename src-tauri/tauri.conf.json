{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaveCode Desktop",
  "version": "0.0.1",
  "identifier": "com.wavenetic.wavecode-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WaveCode Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "resizable": true,
        "titleBarStyle": "Visible",
        "backgroundColor": "#0f172a"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Native desktop client for WaveCode",
    "longDescription": "Tmux-first work surface for the WaveCode multi-agent orchestrator. SSH-only by design."
  }
}
